---
// 隔夜行情條：只放對開盤影響最大的幾項（美股科技、夜盤、日韓、匯率、外資期貨）。資料取自最新一份快照。
import { pct, tone, fmtNum, md } from '../lib/site.mjs';
interface Props { snapshot: any }
const { snapshot: s } = Astro.props;
const g = s.global;
const txf = s.market.txf;
const oi = s.market.foreignFuturesOI;
type Item = { label: string; value: string; change?: string; t: string; date?: string; hl?: boolean };
const items: Item[] = [];
const q = (key: string, label: string, invert = false) => {
  const x = g[key];
  if (x) items.push({ label, value: fmtNum(x.close, x.close < 100 ? 2 : 0), change: pct(x.changePct), t: tone(invert ? -x.changePct : x.changePct), date: md(x.date) });
};
q('sox', '費城半導體');
q('nasdaq', '那斯達克');
if (txf) {
  items.push(txf.night
    ? { label: '台指期夜盤', value: fmtNum(txf.night.close), change: pct(txf.night.changePct), t: tone(txf.night.changePct), date: md(txf.night.session), hl: true }
    : { label: '台指期夜盤', value: '—', change: '未開盤', t: 'flat', hl: true });
}
q('nikkei', '日經');
q('kospi', '韓國');
q('usdtwd', '美元／台幣', true); // 美元兌新台幣上漲＝新台幣貶值，對台股偏空，顏色反過來
if (oi) items.push({ label: '外資期貨', value: `${oi.net >= 0 ? '淨多' : '淨空'} ${fmtNum(Math.abs(oi.net))}`, t: tone(oi.net), date: md(oi.date) });
---
<div class="strip">
  {items.map((i) => (
    <div class:list={['it', i.hl && 'hl']} title={i.date ? `資料日期 ${i.date}` : undefined}>
      <span class="label">{i.label}</span>
      <span class="num value">{i.value}</span>
      {i.change && <span class:list={['num chg', i.t]}>{i.change}</span>}
    </div>
  ))}
</div>

<style>
  .strip { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 2px; }
  .it { flex: 0 0 auto; display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 8px 12px; min-width: 112px; }
  .it.hl { border-color: var(--accent); }
  .label { font-size: 12px; color: var(--muted); }
  .value { font-size: 16px; font-weight: 600; line-height: 1.3; }
  .chg { font-size: 13px; font-weight: 600; }
</style>
