---
// 隔夜行情：分成「大盤」「期貨」「三大法人」三組，不需要左右捲動。資料取自最新一份快照。
import { pct, tone, fmtNum, md } from '../lib/site.mjs';
interface Props { snapshot: any }
const { snapshot: s } = Astro.props;
const g = s.global;
const txf = s.market.txf;
const oi = s.market.foreignFuturesOI;
const inst = s.market.institutional;

// market：瀏覽器依「現在時間」判斷該市場是否交易中（見下方 script），asOf：數字是哪個時間點的資料
type Item = { label: string; value: string; change?: string; t: string; date?: string; hl?: boolean; market?: string; asOf?: string };
const quote = (key: string, label: string, market: string, invert = false): Item | null => {
  const x = g[key];
  return x ? { label, value: fmtNum(x.close, x.close < 100 ? 2 : 0), change: pct(x.changePct), t: tone(invert ? -x.changePct : x.changePct), date: md(x.date), market, asOf: `${md(x.date)} 收盤` } : null;
};
const fetchedTpe = new Date(Date.parse(s.meta.fetchedAt) + 8 * 3600e3).toISOString();
const fetchedText = `${md(fetchedTpe.slice(0, 10))} ${fetchedTpe.slice(11, 16)}`;
const yi = (n: number) => `${n > 0 ? '+' : ''}${fmtNum(n, 1)}`;

const groups: { title: string; unit?: string; cols: number; items: Item[] }[] = [
  {
    title: '大盤',
    cols: 3,
    items: [
      quote('taiex', '台股加權', 'tw'),
      quote('sox', '費城半導體', 'us'),
      quote('nasdaq', '那斯達克', 'us'),
      quote('nikkei', '日經', 'jp'),
      quote('kospi', '韓國', 'kr'),
      quote('usdtwd', '美元／台幣', 'fx', true), // 美元兌新台幣上漲＝新台幣貶值，對台股偏空，顏色反過來
    ].filter(Boolean) as Item[],
  },
  {
    title: '期貨',
    cols: 1,
    items: [
      ...(txf ? [txf.night
        ? { label: '台指期夜盤', value: fmtNum(txf.night.close), change: pct(txf.night.changePct), t: tone(txf.night.changePct), date: md(txf.night.session), market: 'txf', asOf: `${fetchedText} 的價格` }
        : { label: '台指期夜盤', value: '—', change: '未開盤', t: 'flat', market: 'txf', asOf: '' }] : []),
      ...(oi ? [{ label: `外資淨${oi.net >= 0 ? '多' : '空'}單（口）`, value: fmtNum(Math.abs(oi.net)), t: tone(oi.net), date: md(oi.date) }] : []),
    ],
  },
  {
    title: '三大法人',
    unit: inst ? `${md(inst.date)}・億元` : undefined,
    cols: 2,
    items: inst
      ? (() => {
          // 自營商只計自行買賣（避險部位無法判讀，不列入）
          const dealer = inst.dealerSelf ?? inst.dealer;
          const sum = Math.round((inst.foreign + inst.trust + dealer) * 10) / 10;
          return [
            { label: '外資', value: yi(inst.foreign), t: tone(inst.foreign) },
            { label: '投信', value: yi(inst.trust), t: tone(inst.trust) },
            { label: '自營商', value: yi(dealer), t: tone(dealer) },
            { label: '合計', value: yi(sum), t: tone(sum) },
          ];
        })()
      : [],
  },
].filter((x) => x.items.length);
---
<div class="board">
  {groups.map((grp) => (
    <section class="grp" style={`--cols:${grp.cols}`}>
      <div class="grp-title">{grp.title}{grp.unit && <span class="unit">{grp.unit}</span>}</div>
      <div class="items">
        {grp.items.map((i) => (
          <div class:list={['it', i.hl && 'hl']} title={i.date ? `資料日期 ${i.date}` : undefined} data-market={i.market} data-asof={i.asOf}>
            <span class="label">{i.label}</span>
            <span class:list={['num value', !i.change && i.t]}>{i.value}</span>
            {i.change && <span class:list={['num chg', i.t]}>{i.change}</span>}
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<script>
  // 依「現在時間」判斷各市場是否交易中（各市場當地時間，自動處理美國夏令時間）。不需要抓資料，任何時候打開都正確。
  const local = (tz: string) => {
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date()).map((x) => [x.type, x.value]));
    return { wd: parts.weekday, m: (Number(parts.hour) % 24) * 60 + Number(parts.minute) };
  };
  const weekday = (wd: string) => !['Sat', 'Sun'].includes(wd);
  const open: Record<string, () => boolean> = {
    us: () => { const x = local('America/New_York'); return weekday(x.wd) && x.m >= 570 && x.m < 960; }, // 09:30～16:00
    jp: () => { const x = local('Asia/Tokyo'); return weekday(x.wd) && x.m >= 540 && x.m < 930; }, // 09:00～15:30
    kr: () => { const x = local('Asia/Seoul'); return weekday(x.wd) && x.m >= 540 && x.m < 930; },
    tw: () => { const x = local('Asia/Taipei'); return weekday(x.wd) && x.m >= 540 && x.m < 810; }, // 09:00～13:30
    // 台指期夜盤 15:00～隔日 05:00（週一～週五開盤，所以週六 05:00 前也算）
    txf: () => { const x = local('Asia/Taipei'); return (weekday(x.wd) && x.m >= 900) || (['Tue', 'Wed', 'Thu', 'Fri', 'Sat'].includes(x.wd) && x.m < 300); },
  };
  // 交易中的市場加黃框；滑鼠移上去顯示數字是哪個時間點的資料
  const update = () => document.querySelectorAll<HTMLElement>('[data-market]').forEach((el) => {
    const f = open[el.dataset.market!];
    const on = f ? f() : false;
    el.classList.toggle('trading', on);
    el.title = on ? `交易中・此為 ${el.dataset.asof || '更新當時'}的資料` : (el.dataset.asof ? `資料：${el.dataset.asof}` : '');
  });
  update();
  setInterval(update, 60000);
</script>

<style>
  .it.trading { border-color: var(--accent); }
  /* 電腦版三組並排（比例依項目欄數），不捲動；平板以下改為上下排列 */
  .board { display: grid; grid-template-columns: 3fr 1fr 2fr; gap: 12px; }
  .grp { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 12px 12px; min-width: 0; }
  .grp-title { font-size: 12px; font-weight: 700; color: var(--muted); letter-spacing: 0.08em; margin-bottom: 8px; display: flex; justify-content: space-between; gap: 8px; }
  .unit { font-weight: 400; color: var(--dim); letter-spacing: 0; }
  .items { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 8px; }
  .it { display: flex; flex-direction: column; background: var(--panel-2); border: 1px solid transparent; border-radius: var(--radius-sm); padding: 7px 10px; min-width: 0; }
  .it.hl { border-color: var(--accent); }
  .label { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .value { font-size: 16px; font-weight: 600; line-height: 1.3; }
  .value.up { color: var(--up); }
  .value.down { color: var(--down); }
  .chg { font-size: 13px; font-weight: 600; }
  @media (max-width: 900px) {
    .board { grid-template-columns: 1fr; gap: 8px; }
    .grp:nth-child(2) .items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grp:nth-child(3) .items { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .grp { padding: 8px 10px 10px; }
    .items { gap: 6px; }
    .it { padding: 6px 8px; }
    .value { font-size: 15px; }
    .grp:nth-child(3) .items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
