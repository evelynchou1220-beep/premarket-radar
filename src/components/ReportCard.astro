---
// 報告列表卡片（首頁、個股頁共用）。
import VerdictBadge from './VerdictBadge.astro';
import { url, md, weekday, pct, tone, MODE_LABEL } from '../lib/site.mjs';
interface Props { report: any }
const { report: r } = Astro.props;
const d = r.data;
---
<a class="rc" href={url(`reports/${r.id}`)}>
  <div class="top">
    <div>
      <div class="title"><span class="num code">{d.code}</span> {d.name}</div>
      <div class="muted small">{md(d.target)}（{weekday(d.target)}）盤前預測<span class:list={['mode', d.mode]}>{MODE_LABEL[d.mode]}</span></div>
    </div>
    <VerdictBadge verdict={d.verdict} confidence={d.confidence} />
  </div>
  <p class="summary">{d.summary}</p>
  <div class="foot small">
    <span class="muted">多 {r.score.bull}・空 {r.score.bear}・中性 {r.score.neutral}{r.score.missing ? `・缺漏 ${r.score.missing}` : ''}</span>
    {r.void ? (
      <span class="tag">⊘ 休市作廢</span>
    ) : r.result ? (
      <span class:list={['tag', r.result.hit ? 'accent' : '']}>
        {r.result.hit ? '✔ 命中' : '✘ 未中'}｜實際 <span class:list={['num', tone(r.result.changePct)]}>{pct(r.result.changePct)}</span>
      </span>
    ) : (
      <span class="tag">⏳ 待驗證</span>
    )}
  </div>
</a>

<style>
  .rc { display: block; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; transition: border-color 0.15s, transform 0.15s; }
  .rc:hover { border-color: var(--line-strong); text-decoration: none; transform: translateY(-1px); }
  .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 10px; }
  .title { font-weight: 700; font-size: 17px; }
  .code { color: var(--accent); }
  .summary { color: var(--text); font-size: 14px; }
  .mode { margin-left: 8px; padding: 1px 7px; border-radius: 999px; font-size: 11px; border: 1px solid var(--line-strong); color: var(--muted); }
  .mode.ai { border-color: var(--info); color: var(--info); }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
</style>
