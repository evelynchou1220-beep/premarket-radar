---
// 盤後戰情（首頁）：只放數據與新聞，不放預測（預測在「戰況預測」頁，CLAUDE.md §3.3）。
// 資料取最新一份快照：16:10 排程抓的盤後數據，隔天 05:40 再更新成含隔夜行情的版本。最上方是雲端 AI 的盤後分析（§7.6）。
import Base from '../layouts/Base.astro';
import MarketBoard from '../components/MarketBoard.astro';
import NewsAlerts from '../components/NewsAlerts.astro';
import LeveragedRadar from '../components/LeveragedRadar.astro';
import ForeignFlow from '../components/ForeignFlow.astro';
import { snapshots, recaps, watchlist, url, md, weekday, fmtNum, lots, pct, tone } from '../lib/site.mjs';

const watchCodes = watchlist.stocks.map((s) => s.code);
// 每檔追蹤股票取最新的快照（不一定有報告：16:10 只抓數據、不產生預測）
const latestSnap = (code: string) => Object.values(snapshots).filter((s: any) => s.meta.code === code)
  .sort((a: any, b: any) => b.meta.fetchedAt.localeCompare(a.meta.fetchedAt))[0];
const snaps = watchCodes.map(latestSnap).filter(Boolean);
const snap = [...snaps].sort((a, b) => b.meta.fetchedAt.localeCompare(a.meta.fetchedAt))[0];
const day = snap?.meta.basedOn;
const recap = recaps.find((r: any) => r.date === day);

// 六檔個股當日數據：收盤、漲跌、三大法人（張，自營商只計自行買賣）、融資增減
const rows = snaps.map((s: any) => {
  const inst = s.institutional?.at(-1);
  const instOk = inst?.date === s.meta.basedOn;
  const m = s.margin && s.margin.date === s.meta.basedOn ? s.margin : null;
  return {
    code: s.meta.code, name: s.meta.name, close: s.indicators.close, chg: s.indicators.changePct,
    foreign: instOk ? inst.foreign : null, trust: instOk ? inst.trust : null, dealer: instOk ? inst.dealerSelf : null,
    margin: m ? m.marginToday - m.marginPrev : null,
    news: s.news?.stock ?? [],
  };
});
const marketNews = snap?.news?.market ?? [];
const alertCount = (items: any[]) => items.filter((x) => x.tags.length).length;
---
<Base title="盤後戰情" active="home">
  {!snap ? (
    <div class="panel section"><h1>還沒有資料</h1><p class="muted">下一個開盤日收盤後會自動產生。</p></div>
  ) : (
    <>
      <h1>{md(day)}（{weekday(day)}）盤後戰情</h1>
      <p class="small muted sub">只有數據與新聞<span class="hide-sm">，預測請看「戰況預測」</span>{!snap.meta.timingOk && <span class="warn">・美股與夜盤尚未更新</span>}</p>

      {recap && (
        <section class="section panel recap">
          <div class="panel-title">AI 盤後分析</div>
          <p class="headline">{recap.headline}</p>
          <ul class="pts">{recap.points.map((p: string) => <li>{p}</li>)}</ul>
          <div class="small muted label">下個交易日注意</div>
          <ul class="pts watch">{recap.watch.map((p: string) => <li>{p}</li>)}</ul>
          <details class="small">
            <summary class="muted">參考新聞 {recap.news.length} 則</summary>
            <ul class="src">{recap.news.map((n: any) => <li><a href={n.url} target="_blank" rel="noopener">{n.title}</a> <span class="dim">{n.source}</span></li>)}</ul>
          </details>
        </section>
      )}

      <section class="section"><MarketBoard snapshot={snap} /></section>

      <section class="section panel tbl">
        <div class="panel-title">0050 前六大<span class="small dim">（法人、融資單位：張）</span></div>
        <div class="table-wrap">
          <table class="small">
            <thead><tr><th>股票</th><th>收盤</th><th>漲跌</th><th>外資</th><th>投信</th><th>自營</th><th>融資</th></tr></thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td><a href={url(`stocks/${r.code}`)}>{r.name}</a></td>
                  <td class="num">{fmtNum(r.close, r.close < 100 ? 2 : 0)}</td>
                  <td class:list={['num', tone(r.chg)]}>{pct(r.chg)}</td>
                  {[r.foreign, r.trust, r.dealer, r.margin].map((v) => <td class:list={['num', tone(v)]}>{lots(v)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small dim note hide-sm">自營商只計自行買賣。融資約 21:30 公布，之前顯示「—」。</p>
      </section>

      {snap.market.flows?.length > 0 && <div class="section"><ForeignFlow flows={snap.market.flows} /></div>}

      {(snap.market.leveraged || snap.market.options) && <div class="section"><LeveragedRadar market={snap.market} /></div>}

      <section class="section panel">
        <div class="panel-title">大盤新聞{alertCount(marketNews) > 0 && <span class="warn small">⚠ {alertCount(marketNews)}</span>}</div>
        <NewsAlerts items={marketNews} limit={10} />
      </section>

      <section class="section panel">
        <div class="panel-title">個股新聞</div>
        {rows.map((r, i) => (
          <details class="stock-news" open={i === 0 && r.news.length > 0}>
            <summary><b>{r.name}</b> <span class="small muted">{r.news.length} 則</span>{alertCount(r.news) > 0 && <span class="warn small">⚠ {alertCount(r.news)}</span>}</summary>
            <NewsAlerts items={r.news} limit={6} />
          </details>
        ))}
        <p class="small dim note">新聞為 {md(day)} 13:30 收盤後的標題，只提醒、不計分<span class="hide-sm">；⚠ 是含重大關鍵字的新聞</span>。</p>
      </section>
    </>
  )}
</Base>

<style>
  h1 { font-size: 26px; margin: 4px 0 2px; }
  .sub { margin: 0 0 14px; }
  .warn { color: var(--accent); margin-left: 6px; }
  .tbl table td:first-child { white-space: nowrap; }
  .note { margin: 8px 0 0; }
  .stock-news { border-top: 1px solid var(--line); }
  .stock-news:first-of-type { border-top: 0; }
  .stock-news summary { cursor: pointer; padding: 9px 0; }
  .stock-news[open] { padding-bottom: 8px; }
  .recap { border-left: 3px solid var(--accent); }
  .headline { font-size: 18px; font-weight: 700; margin: 4px 0 8px; }
  .pts { margin: 0 0 10px; padding-left: 20px; line-height: 1.7; }
  .watch li::marker { color: var(--accent); }
  .label { margin-top: 4px; }
  .src { margin: 6px 0 0; padding-left: 18px; line-height: 1.8; }
</style>
