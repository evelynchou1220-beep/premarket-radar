---
// 個股盤前預測報告頁。版面原則（CLAUDE.md §3.3）：上方只放「一眼就懂」的重點，細節全部收合在下方。
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PriceCharts from '../../components/PriceCharts.astro';
import InstitutionalBars from '../../components/InstitutionalBars.astro';
import FactorCard from '../../components/FactorCard.astro';
import NewsAlerts from '../../components/NewsAlerts.astro';
import { getReports, url, md, weekday, pct, tone, fmtNum, categories, factorDefs, signalTone, signalIcon, verdictTone, MODE_LABEL, govBankOf, toYi } from '../../lib/site.mjs';
import factorConfig from '../../data/factors.json';

export async function getStaticPaths() {
  const reports = await getReports();
  return reports.map((r) => {
    const same = reports.filter((x) => x.data.code === r.data.code); // 新到舊
    const i = same.indexOf(r);
    return { params: { id: r.id }, props: { report: r, newer: same[i - 1] ?? null, older: same[i + 1] ?? null } };
  });
}

const { report, newer, older } = Astro.props;
const d = report.data;
const s = report.snapshot;
const res = report.result && !report.void ? report.result : null;
const sc = report.score;
const op = report.open;
const prog = report.program;
const isAuto = d.mode === 'auto';
const { Content } = await render(report);
const ind = s.indicators;

const rank = { 強: 3, 中: 2, 弱: 1 } as Record<string, number>;
const byStrength = (a: any, b: any) => (rank[b.strength] ?? 0) - (rank[a.strength] ?? 0);
const directional = d.factors.filter((f) => f.signal === '偏多' || f.signal === '偏空').sort(byStrength);
const top = directional.slice(0, 3);
const bulls = directional.filter((f) => f.signal === '偏多');
const bears = directional.filter((f) => f.signal === '偏空');

// 開盤預測的依據：隔夜因子
const openFactors = factorConfig.scoring.openFactors.map((k: string) => d.factors.find((f) => f.key === k)).filter(Boolean) as any[];
const openShort: Record<string, string> = { txf: '夜盤', adr: 'ADR', us_market: '美股', asia: '日韓', fx: '匯率' };

// 關鍵價位：低於收盤＝支撐、高於收盤＝壓力
const levels = [
  { label: 'MA20 月線', v: ind.ma20 },
  { label: 'MA60 季線', v: ind.ma60 },
  { label: '60 日高點', v: ind.high60 },
  { label: '60 日低點', v: ind.low60 },
].filter((x) => x.v != null).map((x) => ({ ...x, role: x.v >= ind.close ? '壓力' : '支撐' }));

// 三大法人當日買賣超（張）。自營商只顯示自行買賣；避險部位只有淨額、無法判讀，不顯示（CLAUDE.md §11）
const inst = s.institutional.at(-1);
const instRows = inst && inst.date === d.basedOn
  ? [
      { label: '外資', v: inst.foreign },
      { label: '投信', v: inst.trust },
      { label: '自營商', v: inst.dealerSelf ?? inst.dealer },
    ]
  : null;
const lotsText = (n: number) => `${n > 0 ? '+' : ''}${fmtNum(n)}`;
// 八大官股（使用者提供，只顯示不計分）：undefined＝當天沒有資料、null＝未上榜
const gov = govBankOf(d.basedOn, d.code);
// 散戶：以融資（借錢買股）與融券（借股票賣）餘額的增減觀察，單位張
const m = s.margin && s.margin.date === d.basedOn ? s.margin : null;
const retailRows = m
  ? [
      { label: '融資增減', v: m.marginToday - m.marginPrev, note: `餘額 ${fmtNum(m.marginToday)}` },
      { label: '融券增減', v: m.shortToday - m.shortPrev, note: `餘額 ${fmtNum(m.shortToday)}` },
    ]
  : null;
// 借券賣出（外資放空的主要工具）：餘額增加＝放空增加，顏色反過來（增加顯示綠色）
const lend = s.lending && s.lending.date === d.basedOn ? s.lending : null;

// 盤前新聞警示（程式抓的標題，只提醒、不計分）
const headlines = s.news ? [...s.news.stock, ...s.news.market] : [];
const alertCount = headlines.filter((x: any) => x.tags.length).length;
const stockAlertCount = (s.news?.stock ?? []).filter((x: any) => x.tags.length).length;
const marketAlertCount = alertCount - stockAlertCount;

const icon = (v: string) => ({ 偏多: '▲', 偏空: '▼', 盤整: '◆' })[v];
const confBar = (c: number) => `${Math.round(((c - 50) / 35) * 100)}%`;
---
<Base title={`${d.code} ${d.name} ${md(d.target)} 盤前預測`} description={d.summary} active="predict">
  <nav class="crumb small muted hide-sm">
    <a href={url('stocks')}>個股</a> / <a href={url(`stocks/${d.code}`)}>{d.code} {d.name}</a> / {md(d.target)}
  </nav>

  <!-- 標題 -->
  <header class="head">
    <div>
      <h1><span class="num code">{d.code}</span> {d.name}</h1>
      <div class="small muted">
        {md(d.target)}（{weekday(d.target)}）盤前預測<span class="hide-sm">・依據 {md(d.basedOn)} 收盤</span>
        <span class:list={['mode', d.mode]}>{MODE_LABEL[d.mode]}</span>
      </div>
    </div>
    <div class="last">
      <div class="small muted">{md(d.basedOn)} 收盤</div>
      <div class="num price">{fmtNum(ind.close, ind.close < 100 ? 2 : 0)}</div>
      <div class:list={['num small', tone(ind.changePct)]}>{pct(ind.changePct)}</div>
    </div>
  </header>

  {d.timingNote && <details class="timing small"><summary>⏰ 部分資料不是最新</summary>{d.timingNote}</details>}
  {report.void && <p class="timing small">⊘ {report.result.note}</p>}

  <!-- 1. 三張重點卡：開盤、收盤、關鍵價位 -->
  <section class="picks">
    <article class:list={['pick', verdictTone(op.verdict)]}>
      <div class="pick-label">開盤預測</div>
      <div class="pick-main"><span class="big">{icon(op.verdict)} {op.label}</span><span class="num conf">{op.confidence}%</span></div>
      <div class="meter"><i style={`width:${confBar(op.confidence)}`}></i></div>
      <div class="chips">
        {openFactors.map((f) => <span class:list={['chip', signalTone(f.signal)]} title={f.data}>{openShort[f.key]} {signalIcon(f.signal)}</span>)}
      </div>
      <div class="small dim">平盤 ±{report.openBand}%</div>
      {res && res.openActual && (
        <div class:list={['result', res.openHit ? 'hit' : 'miss']}>
          {res.openHit ? '✔ 命中' : '✘ 未中'}｜實際{res.openActual} <span class:list={['num', tone(res.openPct)]}>{pct(res.openPct)}</span>
        </div>
      )}
    </article>

    <article class:list={['pick', verdictTone(d.verdict)]}>
      <div class="pick-label">收盤預測</div>
      <div class="pick-main"><span class="big">{icon(d.verdict)} {d.verdict}</span><span class="num conf">{d.confidence}%</span></div>
      <div class="meter"><i style={`width:${confBar(d.confidence)}`}></i></div>
      <div class="small muted hide-sm">多 {sc.bull}・空 {sc.bear}・中性 {sc.neutral}{sc.missing ? `・缺漏 ${sc.missing}` : ''}</div>
      <div class="small dim">盤整 ±{report.band}%</div>
      {res && (
        <div class:list={['result', res.hit ? 'hit' : 'miss']}>
          {res.hit ? '✔ 命中' : '✘ 未中'}｜實際{res.actual} <span class:list={['num', tone(res.changePct)]}>{pct(res.changePct)}</span>
        </div>
      )}
    </article>

    <article class="pick">
      <div class="pick-label">籌碼 {md(d.basedOn)}<span class="dim">（張）</span></div>
      {instRows ? (
        <ul class="levels">
          {instRows.map((x) => <li class="two"><span class="muted">{x.label}</span><span class:list={['num', tone(x.v)]}>{lotsText(x.v)}</span></li>)}
        </ul>
      ) : <p class="small muted">法人：證交所尚未公布</p>}
      <ul class="levels">
        <li class="two" title={lend ? `借券賣出餘額 ${fmtNum(lend.today)} 張；當日賣出 ${fmtNum(lend.sold)}、還券 ${fmtNum(lend.returned)}` : '證交所晚間公布'}>
          <span class="muted">借券放空</span>
          {lend ? <span class:list={['num', tone(-lend.change)]}>{lotsText(lend.change)}</span> : <span class="dim small">尚未公布</span>}
        </li>
      </ul>
      {gov !== undefined && (
        <ul class="levels">
          <li class="two" title="八大官股券商買賣超（使用者提供，只顯示不計分）">
            <span class="muted">八大官股</span>
            {gov
              ? <span class:list={['num', gov.side === 'buy' ? 'up' : 'down']} title={`${gov.side === 'buy' ? '買超' : '賣超'}第 ${gov.rank} 名${gov.lots ? `・${fmtNum(gov.lots)} 張` : ''}`}>
                  {gov.side === 'buy' ? '+' : '−'}{gov.unit === '張' ? fmtNum(gov.value) : `${fmtNum(toYi(gov.value, gov.unit), 2)} 億`}
                </span>
              : <span class="dim small">未上榜</span>}
          </li>
        </ul>
      )}
      <div class="sub-label">散戶</div>
      {retailRows ? (
        <ul class="levels">
          {retailRows.map((x) => <li class="two" title={x.note}><span class="muted">{x.label}</span><span class:list={['num', tone(x.v)]}>{lotsText(x.v)}</span></li>)}
        </ul>
      ) : <p class="small muted">融資融券：證交所尚未公布</p>}
    </article>

    <article class="pick">
      <div class="pick-label">關鍵價位</div>
      <ul class="levels">
        {levels.map((l) => (
          <li><span class="muted">{l.label.replace(' 月線', '').replace(' 季線', '')}</span><span class="num">{fmtNum(l.v, l.v < 100 ? 2 : 0)}</span><span class:list={['role', l.role === '支撐' ? 'up' : 'down']}>{l.role}</span></li>
        ))}
      </ul>
    </article>
  </section>

  <p class="summary">{d.summary}</p>
  {alertCount > 0 && (
    <a class="alert-bar small" href="#detail-news">
      ⚠ 盤前新聞：個股 {stockAlertCount} 則、大盤 {marketAlertCount} 則需注意<span class="hide-sm">{isAuto ? '，程式版未納入判斷，建議請 AI 升級為完整版' : '，已由 AI 判讀'}</span> ↓
    </a>
  )}

  <!-- 2. 走勢圖 -->
  <section class="panel section">
    <PriceCharts snapshot={s} />
  </section>

  <!-- 3. 最關鍵的 3 個理由 -->
  <section class="panel section">
    <div class="panel-title"><span>關鍵理由</span><a class="small" href="#detail-factors">全部 {d.factors.length} 個 ↓</a></div>
    {top.length ? (
      <ol class="top">
        {top.map((f) => (
          <li>
            <span class:list={['tag', signalTone(f.signal)]}>{signalIcon(f.signal)} {f.signal}・{f.strength}</span>
            <strong>{factorDefs[f.key].label}</strong>
            <span class="muted hide-sm">{f.data}</span>
          </li>
        ))}
      </ol>
    ) : <p class="muted">沒有偏多或偏空的因子，多空資訊不足。</p>}
    {!isAuto && <p class="small dim note hide-sm">對照：只用程式因子的判定為 {prog.verdict} {prog.confidence}%{prog.verdict === d.verdict ? '，與 AI 完整版相同。' : '，加入新聞因子後結論改變。'}{res && (res.programHit ? '程式版命中。' : '程式版未中。')}</p>}
    {isAuto && <p class="small dim note hide-sm">程式版：排程自動產生，未納入新聞。開盤前對 AI 說「分析今天的 {d.code}」可升級為 AI 完整版。</p>}
  </section>

  <!-- 4. 細節（預設收合） -->
  <section class="section details">
    {s.news && (
      <details id="detail-news" open={alertCount > 0}>
        <summary>盤前新聞（{alertCount > 0 ? `⚠ ${alertCount} 則需注意` : `${headlines.length} 則`}）</summary>
        <p class="small dim">{md(d.basedOn)} 13:30 收盤後的新聞標題，由程式自動抓取，只提醒、不計分。✓ 為主流媒體。</p>
        <div class="small muted sub">個股</div>
        <NewsAlerts items={s.news.stock} limit={6} />
        <div class="small muted sub">大盤</div>
        <NewsAlerts items={s.news.market} limit={6} />
      </details>
    )}
    <details>
      <summary>{isAuto ? '程式' : 'AI'} 分析<span class="hide-sm">：綜合判斷、開盤觀察重點、什麼情況下會看錯</span></summary>
      <div class="prose"><Content /></div>
    </details>
    <details>
      <summary>多方理由 {bulls.length} 個・空方風險 {bears.length} 個</summary>
      <div class="grid grid-2">
        <div class="stack">{bulls.length ? bulls.map((f) => <FactorCard factor={f} />) : <p class="muted">沒有偏多因子。</p>}</div>
        <div class="stack">{bears.length ? bears.map((f) => <FactorCard factor={f} />) : <p class="muted">沒有偏空因子。</p>}</div>
      </div>
    </details>
    <details>
      <summary>法人近 5 日</summary>
      <InstitutionalBars rows={s.institutional} />
    </details>
    <details id="detail-factors">
      <summary>全部因子判定（{d.factors.length}）</summary>
      <div class="table-wrap">
        <table>
          <thead><tr><th>類別</th><th>因子</th><th>判定</th><th>數據</th></tr></thead>
          <tbody>
            {categories.map((c) => d.factors.filter((f) => factorDefs[f.key].category === c.id).map((f, i, arr) => (
              <tr>
                {i === 0 && <td rowspan={arr.length} class="muted">{c.icon} {c.label}</td>}
                <td>{factorDefs[f.key].label}</td>
                <td><span class:list={['tag', signalTone(f.signal)]}>{signalIcon(f.signal)} {f.signal}{f.strength && `・${f.strength}`}</span></td>
                <td class="small">{f.data}</td>
              </tr>
            )))}
          </tbody>
        </table>
      </div>
      <p class="small dim">結論與信心度的算法見 <a href={url('factors')}>判斷規則</a>。</p>
    </details>
    <details>
      <summary>參考新聞（{d.news.length}）</summary>
      {d.news.length ? (
        <ul class="news">
          {d.news.map((n) => (
            <li>
              <a href={n.url} target="_blank" rel="noopener">{n.title}</a>
              <span class="dim small"> — {n.source}・{md(n.date)}{n.factor && factorDefs[n.factor] && `・${factorDefs[n.factor].label}`}</span>
            </li>
          ))}
        </ul>
      ) : <p class="muted small">程式版不搜尋新聞；升級為 AI 完整版時，AI 會搜尋 {md(d.basedOn)} 收盤後的新聞。</p>}
    </details>
    <details>
      <summary>資料來源</summary>
      <p class="small muted">快照：<code>data/snapshots/{d.target}/{d.code}.json</code>，抓取時間 {new Date(s.meta.fetchedAt).toLocaleString('zh-TW', { timeZone: 'Asia/Taipei', hour12: false })}。報告產生：{d.createdAt}</p>
      <ul class="small">{s.meta.sources.map((x: any) => <li><a href={x.url} target="_blank" rel="noopener">{x.name}</a></li>)}</ul>
      {s.meta.warnings.length > 0 && <ul class="small">{s.meta.warnings.map((w: string) => <li class="dim">⚠ {w}</li>)}</ul>}
    </details>
  </section>

  <nav class="pager small">
    {older ? <a href={url(`reports/${older.id}`)}>← {md(older.data.target)} 的預測</a> : <span></span>}
    {newer ? <a href={url(`reports/${newer.id}`)}>{md(newer.data.target)} 的預測 →</a> : <span></span>}
  </nav>
</Base>

<style>
  .crumb { margin-bottom: 10px; }
  .crumb a { color: var(--muted); }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 12px; }
  h1 { font-size: 28px; margin: 0 0 2px; }
  .code { color: var(--accent); }
  .last { text-align: right; }
  .last .price { font-size: 24px; font-weight: 700; line-height: 1.2; }
  .mode { margin-left: 6px; padding: 1px 7px; border-radius: 999px; font-size: 11px; border: 1px solid var(--line-strong); color: var(--muted); }
  .mode.ai { border-color: var(--info); color: var(--info); }
  .timing { color: var(--accent); background: var(--accent-bg); border-radius: var(--radius-sm); padding: 6px 10px; margin-bottom: 12px; }
  .timing summary { cursor: pointer; font-weight: 600; }

  .picks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .pick { background: var(--panel); border: 1px solid var(--line); border-top: 3px solid var(--line-strong); border-radius: var(--radius); padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .pick.up { border-top-color: var(--up); }
  .pick.down { border-top-color: var(--down); }
  .pick.flat { border-top-color: var(--flat); }
  .pick-label { font-size: 13px; color: var(--muted); font-weight: 600; letter-spacing: 0.05em; }
  .pick-main { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .big { font-size: 30px; font-weight: 800; line-height: 1.1; }
  .pick.up .big { color: var(--up); }
  .pick.down .big { color: var(--down); }
  .pick.flat .big { color: var(--flat); }
  .conf { font-size: 20px; font-weight: 700; color: var(--text); }
  .meter { height: 4px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .meter i { display: block; height: 100%; background: currentColor; }
  .pick.up .meter i { background: var(--up); }
  .pick.down .meter i { background: var(--down); }
  .pick.flat .meter i { background: var(--flat); }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .chip { font-size: 12px; padding: 1px 7px; border-radius: 999px; background: var(--panel-2); border: 1px solid var(--line); color: var(--muted); }
  .chip.up { color: var(--up); border-color: var(--up-bg); background: var(--up-bg); }
  .chip.down { color: var(--down); border-color: var(--down-bg); background: var(--down-bg); }
  .result { font-size: 13px; font-weight: 600; margin-top: 2px; }
  .result.hit { color: var(--accent); }
  .result.miss { color: var(--muted); }
  .levels { list-style: none; margin: 0; padding: 0; }
  .levels li { display: grid; grid-template-columns: 1fr auto 36px; gap: 8px; padding: 5px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .levels li:last-child { border-bottom: 0; }
  .role { font-size: 12px; text-align: right; }
  .levels li.two { grid-template-columns: 1fr auto; }
  .sub-label { font-size: 12px; color: var(--muted); font-weight: 600; margin-top: 4px; padding-top: 6px; border-top: 1px dashed var(--line-strong); }

  .summary { font-size: 17px; margin: 14px 0 0; }
  .alert-bar { display: block; margin-top: 10px; padding: 8px 12px; border-radius: var(--radius-sm); background: var(--accent-bg); color: var(--accent); font-weight: 600; }
  .alert-bar:hover { text-decoration: none; filter: brightness(1.15); }
  .sub { margin: 10px 0 2px; font-weight: 600; }
  .top { margin: 0; padding-left: 20px; }
  .top li { margin-bottom: 8px; }
  .top li > * { margin-right: 6px; }
  .note { margin: 6px 0 0; }

  .details { display: flex; flex-direction: column; gap: 8px; }
  .details details { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 0 16px; }
  .details summary { cursor: pointer; padding: 12px 0; font-weight: 600; color: var(--text); list-style: none; }
  .details summary::before { content: '▸ '; color: var(--muted); }
  .details details[open] summary::before { content: '▾ '; }
  .details details[open] { padding-bottom: 16px; }
  .news { padding-left: 18px; margin: 0; }
  .news li { margin-bottom: 8px; }
  .pager { display: flex; justify-content: space-between; margin-top: 24px; }
  @media (max-width: 900px) { .picks { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .picks { gap: 8px; }
    .pick { padding: 10px 12px; gap: 4px; }
    .big { font-size: 22px; }
    .conf { font-size: 15px; }
    .chips { gap: 3px; }
    .chip { font-size: 11px; padding: 0 5px; }
    .levels li { font-size: 13px; padding: 3px 0; grid-template-columns: 1fr auto 28px; }
    .head { align-items: flex-start; }
    .last .price { font-size: 20px; }
    h1 { font-size: 22px; }
    .summary { font-size: 15px; margin-top: 10px; }
    .top li { margin-bottom: 4px; }
  }
</style>
