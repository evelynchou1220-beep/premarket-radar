---
// 預測戰績：所有預測與實際結果對照。資料來自 data/results.json（由 npm run verify 產生）。
// 兩種命中率：程式版（每份報告都能由快照重算，樣本最多）與 AI 完整版（有讀新聞的報告）。
import Base from '../layouts/Base.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { getReports, stats, rateText, url, md, weekday, pct, tone, verdictTone, MODE_LABEL } from '../lib/site.mjs';

const reports = await getReports();
const prog = stats(reports, 'program');
const aiReports = reports.filter((r) => r.data.mode === 'ai');
const ai = stats(aiReports);
const aiProg = stats(aiReports, 'program'); // 同一批 AI 報告，若只用程式因子的命中率
const voided = reports.filter((r) => r.void).length;
const open = stats(reports, 'open');
const draft = stats(reports, 'draft'); // 盤後初版（收盤後產生、沒有隔夜資料）

// 依結論與信心度分組（以程式版判定計算，因為所有報告都有、方法一致）
const progOf = (r: any) => r.program;
const byVerdict = ['偏多', '偏空', '盤整'].map((v) => ({ v, ...stats(reports.filter((r) => progOf(r).verdict === v), 'program') }));
const buckets = [[50, 60], [60, 70], [70, 86]].map(([lo, hi]) => ({
  label: `${lo}–${hi === 86 ? 85 : hi - 1}%`,
  ...stats(reports.filter((r) => progOf(r).confidence >= lo && progOf(r).confidence < hi), 'program'),
}));
const hitTag = (hit: boolean) => (hit ? '✔' : '✘');
const icon = (v: string) => ({ 偏多: '▲', 偏空: '▼', 盤整: '◆' })[v];
// 全部紀錄依預測日分組（新到舊）
const days = [...new Set(reports.map((r) => r.data.target))].map((date) => {
  const list = reports.filter((r) => r.data.target === date);
  const ok = list.filter((r) => r.result && !r.void);
  return { date, list, verified: ok.length, hits: ok.filter((r) => r.result.hit).length, openHits: ok.filter((r) => r.result.openHit).length };
});
---
<Base title="預測戰績" active="record">
  <h1>預測戰績</h1>
  <p class="muted">每份預測在預測日收盤後，以證交所官方收盤價對答案。判定方式：每檔股票依近 20 日波動算出「盤整範圍」（近 20 日每日漲跌幅中位數的一半，最低 ±0.5%），收盤漲跌超過範圍為「偏多」或「偏空」，在範圍內為「盤整」；和預測相同就算命中。預測日若臨時休市（例如颱風），該預測作廢、不列入統計。</p>

  <section class="grid grid-4 section">
    <div class="panel kpi">
      <div class="small muted">盤前・開盤預測</div>
      <div class="num big accent">{rateText(open)}</div>
      <div class="small dim">{open.hits}/{open.verified} 筆<span class="hide-sm">｜開高／開低／平盤</span></div>
    </div>
    <div class="panel kpi">
      <div class="small muted">盤前・收盤預測</div>
      <div class="num big accent">{rateText(prog)}</div>
      <div class="small dim">{prog.hits}/{prog.verified} 筆<span class="hide-sm">｜05:40 正式版（程式）</span></div>
    </div>
    <div class="panel kpi">
      <div class="small muted">盤後初版・收盤預測</div>
      <div class="num big">{rateText(draft)}</div>
      <div class="small dim">{draft.hits}/{draft.verified} 筆<span class="hide-sm">｜收盤後產生、沒有隔夜資料</span></div>
    </div>
    <div class="panel kpi">
      <div class="small muted">AI 完整版・收盤預測</div>
      <div class="num big info">{rateText(ai)}</div>
      <div class="small dim">{ai.hits}/{ai.verified} 筆<span class="hide-sm">｜同批只用程式因子 {rateText(aiProg)}</span></div>
    </div>
  </section>
  <p class="small muted bt">三年回測（2023/11～2026/11，6 檔共 4,361 筆，現行公式）：盤前開盤 <b class="num">56.3%</b>、盤前收盤 <b class="num">39.1%</b>、盤後初版 <b class="num">32.3%</b>；亂猜約 33%。<span class="hide-sm">夜盤、美股、ADR 決定了大部分的準確度，所以盤後初版只能當參考。</span></p>
  <p class="small dim">共 {reports.length} 份預測：待驗證 {prog.pending}、作廢 {voided}。開盤預測只用隔夜資訊（夜盤、ADR、美股、日韓、匯率），平盤範圍同樣依個股近 20 日開盤跳空幅度計算。</p>

  <section class="grid grid-2 section">
    <div class="panel">
      <div class="panel-title">程式版：依結論</div>
      <table>
        <thead><tr><th>結論</th><th>次數</th><th>已驗證</th><th>命中率</th></tr></thead>
        <tbody>{byVerdict.map((b) => <tr><td>{b.v}</td><td class="num">{b.total}</td><td class="num">{b.verified}</td><td class="num">{rateText(b)}</td></tr>)}</tbody>
      </table>
    </div>
    <div class="panel">
      <div class="panel-title">程式版：依信心度（檢查信心度是否可信）</div>
      <table>
        <thead><tr><th>信心度</th><th>次數</th><th>已驗證</th><th>命中率</th></tr></thead>
        <tbody>{buckets.map((b) => <tr><td>{b.label}</td><td class="num">{b.total}</td><td class="num">{b.verified}</td><td class="num">{rateText(b)}</td></tr>)}</tbody>
      </table>
      <p class="dim small" style="margin:10px 0 0">理想情況下，信心度越高的組別命中率應該越高。若沒有，代表評分公式需要調整（見 CLAUDE.md §8.6）。</p>
    </div>
  </section>

  <section class="panel section">
    <div class="panel-title">全部紀錄</div>
    <!-- 依預測日收合：最新一天預設展開；手機一檔一行，電腦版表格（CLAUDE.md §3.1） -->
    {days.map((day, di) => (
      <details class="day" open={di === 0}>
        <summary>
          <b class="num">{md(day.date)}（{weekday(day.date)}）</b>
          <span class="small muted">{day.list.length} 檔</span>
          <span class="small">{day.verified ? <>開盤 <b class="num">{day.openHits}/{day.verified}</b>・收盤 <b class="num">{day.hits}/{day.verified}</b></> : <span class="dim">⏳ 待驗證</span>}</span>
        </summary>

        <ul class="rows show-sm">
          {day.list.map((r: any) => {
            const res = r.result && !r.void ? r.result : null;
            return (
              <li>
                <a href={url(`reports/${r.id}`)}>
                  <span class="nm">{r.data.code} {r.data.name}</span>
                  <span class:list={['v', verdictTone(r.open.verdict)]}>{icon(r.open.verdict)}{r.open.label}{res?.openActual && <i>{hitTag(res.openHit)}</i>}</span>
                  <span class:list={['v', verdictTone(r.data.verdict)]}>{icon(r.data.verdict)}{r.data.verdict}{res && <i>{hitTag(res.hit)}</i>}</span>
                  <span class="rs small">{r.void ? '作廢' : res ? <span class:list={['num', tone(res.changePct)]}>{pct(res.changePct)}</span> : <span class="dim">待驗證</span>}</span>
                </a>
              </li>
            );
          })}
        </ul>

        <div class="table-wrap hide-sm">
          <table>
            <thead><tr><th>股票</th><th>版本</th><th>開盤預測</th><th>盤後初版</th><th>報告結論</th><th>程式版</th><th>盤整範圍</th><th>開盤</th><th>收盤</th><th>實際</th><th>結果</th></tr></thead>
            <tbody>
              {day.list.map((r: any) => (
                <tr>
                  <td><a href={url(`reports/${r.id}`)}>{r.data.code} {r.data.name}</a></td>
                  <td class="small">{MODE_LABEL[r.data.mode]}</td>
                  <td class="small">{r.open.label} {r.open.confidence}%{r.result?.openActual && ` → ${r.result.openActual} ${r.result.openHit ? '✔' : '✘'}`}</td>
                  <td class="small">{r.draft ? `${r.draft.verdict}${r.draftHit == null ? '' : r.draftHit ? ' ✔' : ' ✘'}` : '—'}</td>
                  <td><VerdictBadge verdict={r.data.verdict} confidence={r.data.confidence} /></td>
                  <td class="small">{r.data.mode === 'ai' ? `${r.program.verdict} ${r.program.confidence}%` : '同左'}</td>
                  <td class="num small">±{r.band}%</td>
                  <td class:list={['num', r.result?.openPct != null && tone(r.result.openPct)]}>{r.result?.openPct != null ? pct(r.result.openPct) : '—'}</td>
                  <td class:list={['num', r.result?.changePct != null && tone(r.result.changePct)]}>{r.result?.changePct != null ? pct(r.result.changePct) : '—'}</td>
                  <td>{r.result?.actual ?? '—'}</td>
                  <td>{
                    r.void ? <span class="tag">⊘ 作廢</span>
                    : r.result ? (
                      <span class:list={['tag', r.result.hit ? 'accent' : '']}>
                        {hitTag(r.result.hit)} {r.data.mode === 'ai' ? `AI｜程式 ${hitTag(r.result.programHit)}` : r.result.hit ? '命中' : '未中'}
                      </span>
                    ) : <span class="tag">⏳ 待驗證</span>
                  }</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    ))}
  </section>
</Base>

<style>
  .kpi .big { font-size: 28px; font-weight: 600; }
  .accent { color: var(--accent); }
  .info { color: var(--info); }
  .bt { margin: 0 0 4px; }
  .day { border-top: 1px solid var(--line); }
  .day:first-of-type { border-top: 0; }
  .day summary { cursor: pointer; list-style: none; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 10px 0; }
  .day summary::-webkit-details-marker { display: none; }
  .day summary::before { content: '▸'; color: var(--muted); }
  .day[open] summary::before { content: '▾'; }
  .day[open] { padding-bottom: 10px; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li a { display: grid; grid-template-columns: 1.4fr 1fr 1fr 0.9fr; gap: 6px; align-items: center; padding: 7px 4px; border-bottom: 1px solid var(--line); color: var(--text); font-size: 14px; }
  .rows li:last-child a { border-bottom: 0; }
  .rows li a:hover { text-decoration: none; background: var(--panel-2); }
  .nm { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .v { font-weight: 700; white-space: nowrap; }
  .v i { font-style: normal; font-weight: 400; color: var(--muted); margin-left: 3px; }
  .rs { text-align: right; white-space: nowrap; }
  @media (max-width: 640px) { .rows.show-sm { display: block; } }
</style>
