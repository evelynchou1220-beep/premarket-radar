---
// 預測戰績：所有預測與實際結果對照。資料來自 data/results.json（由 npm run verify 產生）。
import Base from '../layouts/Base.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { getReports, stats, url, md, weekday, pct, tone } from '../lib/site.mjs';
import { HIT_THRESHOLD } from '../lib/scoring.mjs';

const reports = await getReports();
const st = stats(reports);
const byVerdict = ['偏多', '偏空', '盤整'].map((v) => ({ v, ...stats(reports.filter((r) => r.data.verdict === v)) }));
const buckets = [[50, 60], [60, 70], [70, 86]].map(([lo, hi]) => ({
  label: `${lo}–${hi === 86 ? 85 : hi - 1}%`,
  ...stats(reports.filter((r) => r.data.confidence >= lo && r.data.confidence < hi)),
}));
---
<Base title="預測戰績" active="record">
  <h1>預測戰績</h1>
  <p class="muted">每份預測在預測日收盤後，以證交所官方收盤價對答案。判定方式：收盤漲幅 ≥ +{HIT_THRESHOLD}% 為「偏多」、≤ −{HIT_THRESHOLD}% 為「偏空」，介於兩者之間為「盤整」；和預測相同就算命中。</p>

  <section class="grid grid-4 section">
    <div class="panel kpi"><div class="small muted">總預測</div><div class="num big">{st.total}</div></div>
    <div class="panel kpi"><div class="small muted">已驗證</div><div class="num big">{st.verified}</div></div>
    <div class="panel kpi"><div class="small muted">命中</div><div class="num big">{st.hits}</div></div>
    <div class="panel kpi"><div class="small muted">命中率</div><div class="num big accent">{st.rate == null ? '—' : st.rate + '%'}</div></div>
  </section>

  <section class="grid grid-2 section">
    <div class="panel">
      <div class="panel-title">依結論</div>
      <table>
        <thead><tr><th>結論</th><th>次數</th><th>已驗證</th><th>命中率</th></tr></thead>
        <tbody>{byVerdict.map((b) => <tr><td>{b.v}</td><td class="num">{b.total}</td><td class="num">{b.verified}</td><td class="num">{b.rate == null ? '—' : b.rate + '%'}</td></tr>)}</tbody>
      </table>
    </div>
    <div class="panel">
      <div class="panel-title">依信心度（檢查信心度是否可信）</div>
      <table>
        <thead><tr><th>信心度</th><th>次數</th><th>已驗證</th><th>命中率</th></tr></thead>
        <tbody>{buckets.map((b) => <tr><td>{b.label}</td><td class="num">{b.total}</td><td class="num">{b.verified}</td><td class="num">{b.rate == null ? '—' : b.rate + '%'}</td></tr>)}</tbody>
      </table>
      <p class="dim small" style="margin:10px 0 0">理想情況下，信心度越高的組別命中率應該越高。若沒有，代表評分公式需要調整（見 CLAUDE.md §9）。</p>
    </div>
  </section>

  <section class="panel section">
    <div class="panel-title">全部紀錄</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>預測日</th><th>股票</th><th>預測</th><th>開盤</th><th>收盤</th><th>實際</th><th>結果</th></tr></thead>
        <tbody>
          {reports.map((r) => (
            <tr>
              <td class="num">{md(r.data.target)}（{weekday(r.data.target)}）</td>
              <td><a href={url(`reports/${r.id}`)}>{r.data.code} {r.data.name}</a></td>
              <td><VerdictBadge verdict={r.data.verdict} confidence={r.data.confidence} /></td>
              <td class:list={['num', r.result && tone(r.result.openPct)]}>{r.result ? pct(r.result.openPct) : '—'}</td>
              <td class:list={['num', r.result && tone(r.result.changePct)]}>{r.result ? pct(r.result.changePct) : '—'}</td>
              <td>{r.result?.actual ?? '—'}</td>
              <td>{r.result ? (r.result.hit ? <span class="tag accent">✔ 命中</span> : <span class="tag">✘ 未中</span>) : <span class="tag">⏳ 待驗證</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .kpi .big { font-size: 28px; font-weight: 600; }
  .accent { color: var(--accent); }
</style>
